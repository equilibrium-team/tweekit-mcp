{
  "manifest_version": "0.3",
  "name": "tweekit-mcp",
  "display_name": "TweekIT MCP Server",
  "version": "1.8.0",
  "description": "TweekIT MCP Server by AMPS dba Equilibrium - convert, preflight, and optimize 450+ file formats on-demand for AI Hub workflows, Claude, OpenAI, Gemini, and web pipelines.",
  "author": {
    "name": "AMPS dba Equilibrium & CPUcoin.io",
    "url": "https://www.equilibrium.com",
    "email": "support@tweekit.io"
  },
  "homepage": "https://www.tweekit.io",
  "documentation": "https://github.com/equilibrium-team/tweekit-mcp",
  "privacy_policies": [
    "https://tweekit.io/privacy/"
  ],
  "server": {
    "type": "python",
    "entry_point": "server/server.py",
    "mcp_config": {
      "command": "python3",
      "args": [
        "${__dirname}/server/server.py",
        "--transport",
        "stdio"
      ],
      "env": {
        "PYTHONPATH": "${__dirname}/python",
        "TWEEKIT_API_KEY": "${user_config.TWEEKIT_API_KEY}",
        "TWEEKIT_API_SECRET": "${user_config.TWEEKIT_API_SECRET}"
      },
      "platform_overrides": {
        "win32": {
          "command": "python"
        },
        "darwin": {
          "command": "/opt/homebrew/bin/python3"
        }
      }
    }
  },
  "license": "MIT",
  "user_config": {
    "TWEEKIT_API_KEY": {
      "type": "string",
      "title": "TweekIT API Key",
      "description": "API key used to authenticate against the upstream TweekIT service.",
      "required": true,
      "sensitive": true
    },
    "TWEEKIT_API_SECRET": {
      "type": "string",
      "title": "TweekIT API Secret",
      "description": "API secret paired with the API key for privileged conversions.",
      "required": true,
      "sensitive": true
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "python": ">=3.10"
    }
  }
}
